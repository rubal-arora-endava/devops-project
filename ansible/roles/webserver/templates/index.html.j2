<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ nginx_site_name }}</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 40px; background: #f4f7fa; color: #333; }
      .container { max-width: 700px; margin: auto; padding: 20px; background: white; border-radius: 10px; box-shadow: 0 3px 10px rgba(0,0,0,0.1); }
      h1 { color: #1f4e79; }
      p { line-height: 1.6; }
      .metadata { margin-top: 20px; padding: 15px; background: #eef5ff; border-left: 4px solid #1f4e79; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>{{ nginx_site_name }}</h1>
      <p>This web service is deployed by Ansible and served by Nginx on the Linux VM backend pool.</p>
      <div class="metadata">
        <p><strong>Environment:</strong> {{ environment_name }}</p>
        <p><strong>Application:</strong> Azure Linux web workload</p>
      </div>
    </div>
  </body>
</html>
